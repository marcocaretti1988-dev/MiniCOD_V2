extends RefCounted
## Procedural textures generated by code (no external image files).
## Used through: const ProcTex := preload("res://scripts/procedural_textures.gd")

const WORLD_SIZE := 100.0


## Builds a tileable concrete slab texture set.
## Returns { "albedo": ImageTexture, "normal": ImageTexture }.
static func make_concrete(size: int = 512, seed_value: int = 7) -> Dictionary:
	var blotch := FastNoiseLite.new()
	blotch.seed = seed_value
	blotch.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
	blotch.frequency = 0.006
	blotch.fractal_octaves = 4

	var grain := FastNoiseLite.new()
	grain.seed = seed_value + 11
	grain.noise_type = FastNoiseLite.TYPE_SIMPLEX
	grain.frequency = 0.09
	grain.fractal_octaves = 3

	var pores := FastNoiseLite.new()
	pores.seed = seed_value + 23
	pores.noise_type = FastNoiseLite.TYPE_CELLULAR
	pores.frequency = 0.12

	var blotch_img := blotch.get_seamless_image(size, size)
	var grain_img := grain.get_seamless_image(size, size)
	var pores_img := pores.get_seamless_image(size, size)

	var albedo := Image.create(size, size, false, Image.FORMAT_RGB8)
	var height := Image.create(size, size, false, Image.FORMAT_RGB8)
	var joint := 3  # slab joint width in pixels (tile edge)

	for y in size:
		for x in size:
			var b := blotch_img.get_pixel(x, y).r
			var g := grain_img.get_pixel(x, y).r
			var p := pores_img.get_pixel(x, y).r
			var v := 0.50 + (b - 0.5) * 0.24 + (g - 0.5) * 0.10
			var h := 0.55 + (g - 0.5) * 0.5 + (b - 0.5) * 0.2
			# Small dark pores / pits.
			if p < 0.12:
				v *= 0.72
				h -= 0.25
			# Expansion joints between slabs.
			if x < joint or y < joint:
				v *= 0.42
				h = 0.0
			elif x < joint + 2 or y < joint + 2:
				v *= 0.8
				h *= 0.6
			v = clampf(v, 0.0, 1.0)
			h = clampf(h, 0.0, 1.0)
			# Slightly warm grey.
			albedo.set_pixel(x, y, Color(v, v * 0.985, v * 0.955))
			height.set_pixel(x, y, Color(h, h, h))

	albedo.generate_mipmaps()
	height.bump_map_to_normal_map(6.0)
	height.generate_mipmaps(true)

	return {
		"albedo": ImageTexture.create_from_image(albedo),
		"normal": ImageTexture.create_from_image(height),
	}


## Concrete StandardMaterial3D. With triplanar=true it maps in world space (for props).
static func make_concrete_material(uv_scale: float, triplanar: bool = false, tint: Color = Color.WHITE, seed_value: int = 7) -> StandardMaterial3D:
	var tex := make_concrete(512, seed_value)
	var mat := StandardMaterial3D.new()
	mat.albedo_texture = tex["albedo"]
	mat.albedo_color = tint
	mat.normal_enabled = true
	mat.normal_texture = tex["normal"]
	mat.normal_scale = 0.9
	mat.roughness = 0.85
	mat.metallic = 0.0
	mat.metallic_specular = 0.4
	mat.uv1_scale = Vector3(uv_scale, uv_scale, uv_scale)
	mat.uv1_triplanar = triplanar
	mat.uv1_world_triplanar = triplanar
	mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	_add_hd_layers(mat)
	return mat


## 1024 procedural layers laid over the slab texture at a much larger scale so
## the ground does not repeat: roughness variation (centred on 0.85), large
## colour stains and a network of cracks in the normal map.
static func _add_hd_layers(mat: StandardMaterial3D) -> void:
	var ShipTex = load("res://scripts/shipyard_textures.gd")
	var g := func(v: float, a: float = 1.0) -> Color: return Color(v, v, v, a)
	mat.roughness = 1.0
	mat.roughness_texture = ShipTex.noise_texture(401, 0.012, 4,
		[0.0, 0.35, 0.7, 1.0], [g.call(0.55), g.call(0.8), g.call(0.88), g.call(0.97)])
	mat.roughness_texture_channel = BaseMaterial3D.TEXTURE_CHANNEL_GRAYSCALE
	mat.detail_enabled = true
	mat.detail_blend_mode = BaseMaterial3D.BLEND_MODE_MUL
	mat.detail_uv_layer = BaseMaterial3D.DETAIL_UV_2
	mat.uv2_triplanar = true
	mat.uv2_world_triplanar = true
	mat.uv2_scale = Vector3(1.0 / 14.0, 1.0 / 14.0, 1.0 / 14.0)
	# Colour variation / damp stains (multiplied over the slabs). Alpha 0.45 keeps
	# the slab joints of the base normal map visible under the cracks.
	mat.detail_albedo = ShipTex.noise_texture(402, 0.007, 5,
		[0.0, 0.3, 0.6, 1.0],
		[Color(0.5, 0.48, 0.46, 0.45), Color(0.8, 0.78, 0.75, 0.45), Color(1.0, 1.0, 1.0, 0.45), Color(1.0, 0.98, 0.94, 0.45)])
	# Cracks: cellular noise edges turned into a normal map.
	mat.detail_normal = ShipTex.noise_texture(403, 0.012, 2,
		[0.0, 0.035, 0.09, 1.0], [g.call(0.0), g.call(0.55), g.call(1.0), g.call(1.0)],
		FastNoiseLite.TYPE_CELLULAR, true, 14.0)


# ---------------------------------------------------------------------------
# Ground markings "canvas": painted lines + tire marks on a transparent layer.
# Pixel X = world X, pixel Y = world Z, covering WORLD_SIZE x WORLD_SIZE metres.
# ---------------------------------------------------------------------------

static func make_ground_markings(size: int = 2048, seed_value: int = 1337) -> ImageTexture:
	var img := Image.create(size, size, false, Image.FORMAT_RGBA8)
	img.fill(Color(0.9, 0.9, 0.85, 0.0))
	var rng := RandomNumberGenerator.new()
	rng.seed = seed_value

	var white := Color(0.92, 0.92, 0.88, 0.9)
	var yellow := Color(0.95, 0.72, 0.1, 0.9)

	# Perimeter line.
	_line_rect(img, size, -45.0, -45.0, 45.0, 45.0, 0.2, white)

	# Road along Z: solid edges + dashed yellow centre line.
	_rect_m(img, size, -5.1, -45.0, -4.9, 45.0, white)
	_rect_m(img, size, 4.9, -45.0, 5.1, 45.0, white)
	var z := -44.0
	while z < 44.0:
		_rect_m(img, size, -0.08, z, 0.08, z + 3.0, yellow)
		z += 6.0

	# Crosswalk.
	var x := -4.5
	while x < 4.5:
		_rect_m(img, size, x, -17.0, x + 0.5, -14.0, white)
		x += 1.0

	# Stop line.
	_rect_m(img, size, -4.9, -12.6, 0.0, -12.2, white)

	# Parking bays on the right side.
	_rect_m(img, size, 12.0, -30.0, 12.15, 30.0, white)
	z = -30.0
	while z <= 30.0:
		_rect_m(img, size, 12.0, z - 0.07, 18.0, z + 0.07, white)
		z += 3.0

	# Yellow hazard box with diagonal stripes on the left side.
	_hazard_box(img, size, -22.0, -6.0, -12.0, 6.0, yellow)

	# Wear: chip small bits of paint away.
	var clear := Color(0.9, 0.9, 0.85, 0.0)
	for i in 9000:
		var px := rng.randi_range(0, size - 4)
		var py := rng.randi_range(0, size - 4)
		img.fill_rect(Rect2i(px, py, rng.randi_range(1, 3), rng.randi_range(1, 3)), clear)

	# Tire marks: pairs of dark curved tracks.
	for i in 16:
		var start := Vector2(rng.randf_range(-35.0, 35.0), rng.randf_range(-35.0, 35.0))
		if i < 6:
			start.x = rng.randf_range(-4.0, 4.0)  # some of them on the road
		var heading := rng.randf_range(0.0, TAU)
		if i < 6:
			heading = PI * 0.5 + rng.randf_range(-0.25, 0.25)
		var curvature := rng.randf_range(-0.09, 0.09)
		var length := rng.randf_range(8.0, 24.0)
		_tire_mark(img, size, rng, start, heading, curvature, length)

	img.generate_mipmaps()
	return ImageTexture.create_from_image(img)


static func make_markings_material() -> StandardMaterial3D:
	var mat := StandardMaterial3D.new()
	mat.albedo_texture = make_ground_markings()
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.roughness = 0.7
	mat.metallic = 0.0
	mat.metallic_specular = 0.35
	mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	return mat


static func _to_px(m: float, size: int) -> int:
	return int(round((m + WORLD_SIZE * 0.5) / WORLD_SIZE * float(size)))


static func _rect_m(img: Image, size: int, x0: float, z0: float, x1: float, z1: float, color: Color) -> void:
	var p0 := Vector2i(_to_px(x0, size), _to_px(z0, size))
	var p1 := Vector2i(_to_px(x1, size), _to_px(z1, size))
	var r := Rect2i(p0, Vector2i(maxi(p1.x - p0.x, 2), maxi(p1.y - p0.y, 2)))
	img.fill_rect(r.intersection(Rect2i(0, 0, size, size)), color)


static func _line_rect(img: Image, size: int, x0: float, z0: float, x1: float, z1: float, w: float, color: Color) -> void:
	_rect_m(img, size, x0, z0, x1, z0 + w, color)
	_rect_m(img, size, x0, z1 - w, x1, z1, color)
	_rect_m(img, size, x0, z0, x0 + w, z1, color)
	_rect_m(img, size, x1 - w, z0, x1, z1, color)


static func _hazard_box(img: Image, size: int, x0: float, z0: float, x1: float, z1: float, color: Color) -> void:
	var p0 := Vector2i(_to_px(x0, size), _to_px(z0, size))
	var p1 := Vector2i(_to_px(x1, size), _to_px(z1, size))
	var stripe := 24  # pixels (about 1.2 m period)
	for y in range(p0.y, p1.y):
		for x in range(p0.x, p1.x):
			if posmod(x + y, stripe) < 7:
				img.set_pixel(x, y, color)
	_line_rect(img, size, x0, z0, x1, z1, 0.2, color)


static func _tire_mark(img: Image, size: int, rng: RandomNumberGenerator, start: Vector2, heading: float, curvature: float, length: float) -> void:
	var step := 0.04
	var steps := int(length / step)
	var pos := start
	var half_track := 0.8
	var streak := FastNoiseLite.new()
	streak.seed = rng.randi()
	streak.frequency = 0.6
	var strength := rng.randf_range(0.45, 0.85)
	for i in steps:
		var t := float(i) / float(steps)
		var dir := Vector2(cos(heading), sin(heading))
		var side := Vector2(-dir.y, dir.x)
		# Fade in / out along the mark, with irregular skipping.
		var fade := sin(t * PI)
		var n := streak.get_noise_1d(float(i) * step * 4.0) * 0.5 + 0.5
		var alpha := clampf(fade * strength * (0.45 + n * 0.75), 0.0, 0.9)
		for s in [-1.0, 1.0]:
			var c: Vector2 = pos + side * half_track * s
			_stamp(img, size, _to_px(c.x, size), _to_px(c.y, size), 2, Color(0.035, 0.035, 0.04, alpha))
		pos += dir * step
		heading += curvature * step


static func _stamp(img: Image, size: int, cx: int, cy: int, radius: int, color: Color) -> void:
	for dy in range(-radius, radius + 1):
		for dx in range(-radius, radius + 1):
			var x := cx + dx
			var y := cy + dy
			if x < 0 or y < 0 or x >= size or y >= size:
				continue
			var edge := 1.0 if (absi(dx) < radius and absi(dy) < radius) else 0.5
			var under := img.get_pixel(x, y)
			var over := Color(color.r, color.g, color.b, color.a * edge)
			# Keep the strongest rubber layer instead of stacking alpha every step.
			if under.r < 0.2 and under.a >= over.a:
				continue
			img.set_pixel(x, y, under.blend(over))
